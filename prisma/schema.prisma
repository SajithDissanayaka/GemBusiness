generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GemAvailability {
  AVAILABLE
  RESERVED
  SOLD
}

model Gem {
  id    Int    @id @default(autoincrement())
  name  String
  type  String
  carat Float
  price Int
  shape String

  description String
  color       String
  clarity     String
  origin      String
  treatment   String

  availability GemAvailability @default(AVAILABLE)

  certificateNumber String? @unique

  createAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One Gem can have many images
  images GemImage[]
}

model GemImage {
  id Int @id @default(autoincrement())

  // Image URL
  imageUrl String

  // Optional image description
  altText String?

  // Image display order
  sortOrder Int @default(0)

  // Main image or not
  isPrimary Boolean @default(false)

  // Foreign Key
  gemId Int

  // GemImage belongs to one Gem
  gem Gem @relation(fields: [gemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}